# Public host. Change this for your installation.
APP_SITE=chaincert.d.senik.su
# Unique across all applications attached to this Traefik.
APP_TAG=chaincert
DCAPE_ROOT=/opt/dcape
DCAPE_TAG=dcape
DCAPE_NET=dcape
USE_TLS=true
TLS_RESOLVER=default

# Build directly from a published source tag; no prebuilt image is required.
SOURCE_REPO=https://github.com/yurisenik/chaincert.git
SOURCE_REF=v1.1.1
IMAGE=chaincert
IMAGE_VER=v1.1.1

MEM_LIMIT=256m
CPU_LIMIT=1.0
RATE_AVERAGE=5
RATE_BURST=10
MAX_INFLIGHT=10

# Public IPs of this Docker host: prevent AIA fetches back into its services.
# Replace for your installation; comma-separated list.
CHAINCERT_DENY_IPS=78.24.180.212

# Instance-specific notice shown above the check form. Set your actual location.
# Leave empty for the generic notice. Keep this value unquoted for Make + Compose.
CHAINCERT_PROBE_LABEL=Проверка выполняется с сервера в России.
